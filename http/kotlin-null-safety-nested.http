@baseUrl = http://localhost:8080/api/null-safety/nested

# All 16 combinations use NestedChild(@field:NotNull val age: Int?).
# Each endpoint is tested with all six inputs:
# {}, {"child":null}, {"child":{}}, {"child":{"age":null}},
# {"child":{"age":0}}, {"child":{"age":25}}.
# Change @body to compare the same input across every combination.
# child.age=0 or child.age=25 -> 200 OK for all 16 endpoints.
@body = {"child":{"age":null}}

### 1. child nullable=X, child @NotNull=X, child @Valid=X, Controller @Valid=X
# child missing/null -> 400 (Jackson); child.age missing/null -> 200
POST {{baseUrl}}/non-null/plain
Content-Type: application/json

{{body}}

### 2. child nullable=X, child @NotNull=X, child @Valid=X, Controller @Valid=O
# child missing/null -> 400 (Jackson); child.age missing/null -> 200
POST {{baseUrl}}/non-null/plain/valid
Content-Type: application/json

{{body}}

### 3. child nullable=X, child @NotNull=X, child @Valid=O, Controller @Valid=X
# child missing/null -> 400 (Jackson); child.age missing/null -> 200
POST {{baseUrl}}/non-null/cascade
Content-Type: application/json

{{body}}

